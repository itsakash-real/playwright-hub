# path: .env.example
# ─────────────────────────────────────────────────────────────────
# PlaywrightHub — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── Application Under Test ───────────────────────────────────────
# The base URL of SauceDemo. Do not add a trailing slash.
BASE_URL=

# ── SauceDemo Credentials ────────────────────────────────────────
# These are the publicly documented test credentials for SauceDemo.
# standard_user is the primary user for most tests.
SAUCE_USERNAME=
SAUCE_PASSWORD=

# ── GitHub API (for Auto Issue Creation) ─────────────────────────
# Create a GitHub Personal Access Token at:
# https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
# Rotate this token every 90 days.
GITHUB_TOKEN=

# Your GitHub username or organization name (the repo owner)
GITHUB_OWNER=

# The exact name of this repository on GitHub
GITHUB_REPO=

# ── Optional: Slack Notifications (Nightly CI) ───────────────────
# Create an Incoming Webhook at https://api.slack.com/apps
# Only needed for the nightly.yml workflow.
SLACK_WEBHOOK=